{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard.
	"name": "gre-quant-mastery",
	"compatibility_date": "2026-11-19",
	// Only /api/* runs the Worker (accounts, progress sync, friends leaderboard).
	// Everything else is served straight from the Vite build output.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist/",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// No database_id on purpose: Cloudflare creates the D1 database automatically on the
	// first deploy (automatic provisioning). The Worker creates its tables on first use.
	"d1_databases": [
		{ "binding": "DB" }
	],
	"observability": { "enabled": true }
}
